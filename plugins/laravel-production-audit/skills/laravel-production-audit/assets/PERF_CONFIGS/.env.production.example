# .env.production — performance-relevant keys TEMPLATE
# Project: <PROJECT NAME>   Audit date: <DATE>
# Only performance/footprint-relevant keys are listed. Merge into the real
# production .env; do not commit secrets.

APP_ENV=production
APP_DEBUG=false                  # reason: true in prod leaks stack traces and is slow

LOG_CHANNEL=stack
LOG_LEVEL=error                  # reason: debug/info at prod volume floods disk and slows requests

# ── Redis-backed everything (see §5) ─────────────────────────────────────────
CACHE_STORE=redis                # reason: required for ->onOneServer(), tags, atomic locks
SESSION_DRIVER=redis             # reason: file sessions don't scale horizontally
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=phpredis            # reason: C extension — faster and lower memory than predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# reason: separate logical DBs so cache flushes don't wipe the queue
REDIS_DB=1                       # cache
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=0
REDIS_SESSION_DB=2

# ── Broadcasting (only if Reverb/echo in use) ────────────────────────────────
# BROADCAST_CONNECTION=reverb
