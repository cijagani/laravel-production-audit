# .env.production — performance-relevant keys TEMPLATE
# Project: <PROJECT NAME>   Audit date: <DATE>
# Only performance/footprint-relevant keys are listed. Merge into the real
# production .env; do not commit secrets.

APP_ENV=production
APP_DEBUG=false                  # reason: true in prod leaks stack traces and is slow

LOG_CHANNEL=stack
LOG_LEVEL=error                  # reason: debug/info at prod volume floods disk and slows requests

# ── Redis-backed everything (see §5) ─────────────────────────────────────────
CACHE_STORE=redis                # reason: required for ->onOneServer(), tags, atomic locks
SESSION_DRIVER=redis             # reason: file sessions don't scale horizontally
SESSION_LIFETIME=120
SESSION_CONNECTION=session       # reason: unset = sessions land on the 'default' (queue) connection
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE_RETRY_AFTER=90       # reason: must be several seconds ABOVE the largest worker/Horizon timeout (§2.2)

REDIS_CLIENT=phpredis            # reason: C extension — faster and lower memory than predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                  # reason: set it (requirepass/ACL) for any Redis not bound to localhost; keep out of git
# reason: separate logical DBs so `cache:clear` (FLUSHDB) can't wipe the queue.
# Key names match Laravel 13's stock config/database.php.
REDIS_DB=0                       # 'default' connection = queue (+ Horizon)
REDIS_CACHE_DB=1                 # 'cache' connection
REDIS_SESSION_DB=2               # 'session' connection (add it — see redis-separation.md)

# ── Broadcasting (only if Reverb/echo in use) ────────────────────────────────
# BROADCAST_CONNECTION=reverb
